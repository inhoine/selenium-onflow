<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  To enable parallel test execution across classes or tests, set:
  parallel="classes" thread-count="2" (or "methods" / "tests")
  DriverManager uses ThreadLocal<WebDriver> so concurrent tests are fully thread-safe.
-->
<suite name="Selenium Learning TestNG" parallel="false">
    <listeners>
        <listener class-name="com.example.seleniumtestng.listeners.TestListener"/>
        <listener class-name="com.example.seleniumtestng.listeners.AnnotationTransformer"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <test name="Login">
        <classes>
            <class name="com.example.seleniumtestng.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Product">
        <classes>
            <class name="com.example.seleniumtestng.tests.ProductTest"/>
        </classes>
    </test>

    <test name="Inbound Product">
        <classes>
            <class name="com.example.seleniumtestng.tests.InboundProductTest"/>
        </classes>
    </test>

    <test name="Create Order">
        <classes>
            <class name="com.example.seleniumtestng.tests.CreateOrderTest"/>
        </classes>
    </test>

    <test name="Pick Pack">
        <classes>
            <class name="com.example.seleniumtestng.tests.PickPackTest"/>
        </classes>
    </test>

    <test name="Packing Campaign">
        <classes>
            <class name="com.example.seleniumtestng.tests.PackingCampaignTest"/>
        </classes>
    </test>

    <test name="Convert Goods">
        <classes>
            <class name="com.example.seleniumtestng.tests.ConvertGoodsTest"/>
        </classes>
    </test>

    <test name="Return RMA Inspection">
        <classes>
            <class name="com.example.seleniumtestng.tests.ReturnRmaInspectionTest"/>
        </classes>
    </test>
</suite>

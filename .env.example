# Example environment variables for login accounts
OMS_EMAIL=your-oms-email@example.com
OMS_PASSWORD=your-oms-password

OPS_EMAIL=your-ops-email@example.com
OPS_PASSWORD=your-ops-password

WMS_EMAIL=your-wms-email@example.com
WMS_PASSWORD=your-wms-password

# Base URLs for the staging applications
WMS_BASE_URL=https://stg-wms.onflow.vn
OMS_BASE_URL=https://stg-oms.onflow.vn
OPS_BASE_URL=https://stg-ops.onflow.vn

# Default test values
DEFAULT_FC_NAME=FC HN
TEST_TIMEOUT=15000
KEEP_BROWSER_OPEN=false
DEFAULT_PACKING_MATERIAL_CODE=40x20x20

# WMS API retry and picking lookup windows
WMS_API_RETRY_ATTEMPTS=3
PICKPACK_TROLLEY_LOOKBACK_SECONDS=2592000
PICKPACK_TROLLEY_LOOKAHEAD_SECONDS=86400
PICKPACK_TROLLEY_STATUS_IDS=700,

# Packing campaign flow
PACKING_CAMPAIGN_TABLE_CODE=ITTEST
PACKING_CAMPAIGN_PICKUP_CODE=265243
PACKING_CAMPAIGN_PACKING_MATERIAL_CODE=40x20x20
PACKING_CAMPAIGN_PERMISSION_WAIT_MS=5000

# Flow toggles
INBOUND_CREATE_NEW=true
CREATE_ORDER_CREATE_PICKUP=true
